rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Event images
    match /events/{eventId}/{imageId} {
      allow read: true;
      allow write: if isSignedIn() && request.auth.uid == resource.metadata.ownerId;
    }

    // User avatars
    match /avatars/{userId}/{fileName} {
      allow read: true;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Ticket QR images (generated server-side)
    match /tickets/{ticketId}/qr.png {
      allow read: isSignedIn();
      allow write: if false; // Only Cloud Functions can write
    }
  }
}
